{
    "name": "api-service-boilerplate",
    "version": "0.1.0",
    "description": "Solid and minimal Express + TypeScript API boilerplate",
    "repository": {
        "type": "git",
        "url": "https://github.com/your-org/api-service-boilerplate"
    },
    "main": "index.js",
    "engines": {
        "node": ">=20",
        "npm": ">=10"
    },
    "dependencies": {
        "@baskit-app/baskit-node-logger": "^1.0.1",
        "@baskit-app/baskit-openapi-validator": "^0.0.5",
        "body-parser": "^1.20.2",
        "compression": "^1.7.4",
        "env-var": "^7.1.1",
        "eslint-import-resolver-custom-alias": "^1.3.2",
        "express": "^4.18.1",
        "express-http-context": "^1.2.4",
        "helmet": "^7.0.0",
        "http-graceful-shutdown": "^3.1.13",
        "jsonwebtoken": "^9.0.3",
        "module-alias": "^2.2.3",
        "pg": "^8.11.1",
        "reflect-metadata": "^0.1.13",
        "source-map-support": "^0.5.21",
        "swagger-parser": "^10.0.3",
        "typeorm": "^0.3.17",
        "winston": "^3.10.0",
        "winston-loki": "^6.0.6"
    },
    "devDependencies": {
        "@types/compression": "^1.7.2",
        "@types/connect-datadog": "^0.0.6",
        "@types/errorhandler": "1.5.0",
        "@types/express": "^4.17.17",
        "@types/jest": "^28.1.5",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/module-alias": "^2.0.1",
        "@types/ms": "^2.1.0",
        "@types/node": "^20.4.2",
        "@types/pg": "^8.10.2",
        "@types/supertest": "^2.0.12",
        "@typescript-eslint/eslint-plugin": "^6.1.0",
        "@typescript-eslint/parser": "^6.0.0",
        "cross-env": "^7.0.2",
        "dotenv": "^16.3.1",
        "eslint": "^8.44.0",
        "eslint-config-airbnb-typescript": "^17.1.0",
        "eslint-config-prettier": "^8.8.0",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-plugin-filenames": "^1.3.2",
        "eslint-plugin-import": "^2.27.5",
        "eslint-plugin-jest": "^27.2.3",
        "eslint-plugin-prettier": "^5.0.0",
        "husky": "^8.0.3",
        "jest": "^28.1.2",
        "jest-extended": "^4.0.0",
        "lint-staged": "^13.2.3",
        "pino-pretty": "^10.0.1",
        "prettier": "3.0.0",
        "rimraf": "^5.0.1",
        "supertest": "^6.3.3",
        "ts-jest": "^28.0.8",
        "ts-node": "^10.9.1",
        "ts-node-dev": "^2.0.0",
        "tsc-watch": "^6.0.4",
        "tslib": "^2.6.0",
        "tsx": "^4.21.0",
        "typescript": "^5.1.6"
    },
    "scripts": {
        "start": "node ./dist/src/server.js",
        "start:dev": "tsx watch -r dotenv/config src/server.ts",
        "start:worker:example": "ts-node -r dotenv/config src/workers/example-worker.ts",
        "lint": "eslint --ignore-path .eslintignore --ext .ts,.js .",
        "lint:fix": "eslint --ignore-path .eslintignore --ext .ts,.js --fix .",
        "test:all": "cross-env NODE_ENV=test jest --verbose --runInBand --collectCoverage=true ./tests",
        "test": "cross-env NODE_ENV=test jest --verbose --runInBand --collectCoverage=true ./tests/unit",
        "test-integration": "cross-env NODE_ENV=test jest --verbose --runInBand --collectCoverage=true ./tests/integration",
        "test-watch": "cross-env NODE_ENV=test jest -i --watch",
        "build": "rimraf dist && tsc",
        "typeorm": "ts-node -r ./src/module-alias.ts -r dotenv/config ./node_modules/typeorm/cli",
        "migration:create": "npm run typeorm -- migration:create src/libs/typeorm/migrations/baskit-db-migration",
        "migration:generate": "npm run typeorm migration:generate -- -d ./src/libs/typeorm/ormconfig-cli.ts src/libs/typeorm/migrations/baskit-db-migration",
        "migration:show": "npm run typeorm migration:show -- -d ./src/libs/typeorm/ormconfig-cli.ts",
        "migration:run": "npm run typeorm migration:run -- -d ./src/libs/typeorm/ormconfig-cli.ts",
        "migration:revert": "npm run typeorm migration:revert -- -d ./src/libs/typeorm/ormconfig-cli.ts",
        "migration:seed:create": "npm run typeorm -- migration:create src/libs/typeorm/seed/baskit-db-seed",
        "migration:seed:show": "npm run typeorm migration:show -- -d ./src/libs/typeorm/ormconfig-seed-cli.ts",
        "migration:seed:run": "npm run typeorm migration:run -- -d ./src/libs/typeorm/ormconfig-seed-cli.ts",
        "migration:seed:revert": "npm run typeorm migration:revert -- -d ./src/libs/typeorm/ormconfig-seed-cli.ts",
        "format": "prettier --config .prettierrc.js --write \"./**/*.{js,ts,json,yml,yaml}\"",
        "format:check": "prettier --config .prettierrc.js --check \"./**/*.{js,ts,json,yml,yaml}\"",
        "generate-error-map": "tsx src/cmd/generate-error-map generate"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "*.{ts,js,json}": [
            "npm run format"
        ],
        "*.{ts,js}": [
            "eslint"
        ]
    },
    "author": "anom",
    "license": "UNLICENSED",
    "private": true
}
