{
    "name": "api-service-boilerplate",
    "version": "0.1.0",
    "description": "Solid and minimal Express + TypeScript API boilerplate",
    "engines": {
        "node": ">=24",
        "npm": ">=10"
    },
    "dependencies": {
        "compression": "^1.8.2",
        "env-var": "^7.5.0",
        "express": "^5.2.1",
        "express-openapi-validator": "^5.6.2",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "http-graceful-shutdown": "^4.0.0",
        "jsonwebtoken": "^9.0.3",
        "module-alias": "^2.3.4",
        "pg": "^8.23.1",
        "pino": "^10.4.0",
        "pino-http": "^11.0.0",
        "reflect-metadata": "^0.2.2",
        "source-map-support": "^0.5.21",
        "typeorm": "^0.3.31"
    },
    "devDependencies": {
        "@apidevtools/swagger-parser": "^13.1.0",
        "@eslint/js": "^10.0.1",
        "@types/compression": "^1.8.1",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.19.1",
        "@types/pg": "^8.23.1",
        "@types/source-map-support": "^0.5.10",
        "@types/supertest": "^7.2.1",
        "cross-env": "^10.1.0",
        "dotenv": "^18.0.5",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-jest": "^29.16.6",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "jest": "^30.5.2",
        "jest-extended": "^7.0.0",
        "lint-staged": "^17.6.0",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.9.9",
        "rimraf": "^6.1.3",
        "supertest": "^7.3.1",
        "ts-jest": "^29.4.14",
        "tsx": "^4.23.15",
        "typescript": "~5.9",
        "typescript-eslint": "^8.71.0"
    },
    "scripts": {
        "start": "node ./dist/src/server.js",
        "start:dev": "tsx watch -r dotenv/config src/server.ts",
        "start:worker:example": "tsx -r dotenv/config src/workers/example-worker.ts",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "test:all": "cross-env NODE_ENV=test jest --verbose --runInBand --collectCoverage=true ./tests",
        "test": "cross-env NODE_ENV=test jest --verbose --runInBand --collectCoverage=true ./tests/unit",
        "test-integration": "cross-env NODE_ENV=test jest --verbose --runInBand --collectCoverage=true ./tests/integration",
        "test-watch": "cross-env NODE_ENV=test jest -i --watch",
        "build": "rimraf dist && tsc",
        "typeorm": "tsx -r dotenv/config ./node_modules/typeorm/cli.js",
        "migration:create": "npm run typeorm -- migration:create src/libs/typeorm/migrations/db-migration",
        "migration:generate": "npm run typeorm migration:generate -- -d ./src/libs/typeorm/ormconfig-cli.ts src/libs/typeorm/migrations/db-migration",
        "migration:show": "npm run typeorm migration:show -- -d ./src/libs/typeorm/ormconfig-cli.ts",
        "migration:run": "npm run typeorm migration:run -- -d ./src/libs/typeorm/ormconfig-cli.ts",
        "migration:revert": "npm run typeorm migration:revert -- -d ./src/libs/typeorm/ormconfig-cli.ts",
        "migration:seed:create": "npm run typeorm -- migration:create src/libs/typeorm/seed/db-seed",
        "migration:seed:show": "npm run typeorm migration:show -- -d ./src/libs/typeorm/ormconfig-seed-cli.ts",
        "migration:seed:run": "npm run typeorm migration:run -- -d ./src/libs/typeorm/ormconfig-seed-cli.ts",
        "migration:seed:revert": "npm run typeorm migration:revert -- -d ./src/libs/typeorm/ormconfig-seed-cli.ts",
        "format": "prettier --config .prettierrc.js --write \"./**/*.{js,ts,json,yml,yaml}\"",
        "format:check": "prettier --config .prettierrc.js --check \"./**/*.{js,ts,json,yml,yaml}\"",
        "generate-error-map": "tsx src/cmd/generate-error-map && prettier --config .prettierrc.js --write src/domain/errors.ts",
        "prepare": "husky || true"
    },
    "lint-staged": {
        "*.{ts,js,json,yml,yaml}": [
            "prettier --config .prettierrc.js --write"
        ],
        "*.{ts,js}": [
            "eslint --fix"
        ]
    },
    "author": "Iqbal Ramadhan <iqbal.ramadhan3000@gmail.com>",
    "license": "Unlicense"
}
