NODE_ENV=development
APP_ENV=local
SERVICE_NAME=api-service-boilerplate
PORT=3000

PGDATABASE=test
PGHOST=localhost
PGPORT=54321
PGUSER=test
PGPASSWORD=test

# Optional: enable read replica only if all four are set
# PGROHOST=localhost
# PGROPORT=54322
# PGROUSER=test
# PGROPASSWORD=test

# Secret used to sign/verify JWTs (HS256). Set a strong, unique value per environment.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN_SECONDS=3600
