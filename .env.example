NODE_ENV=development
APP_ENV=local
SERVICE_NAME=api-service-boilerplate
PORT=3000

PGDATABASE=test
PGHOST=localhost
PGPORT=54321
PGUSER=test
PGPASSWORD=test

# Optional: enable read replica only if all four are set
# PGROHOST=localhost
# PGROPORT=54322
# PGROUSER=test
# PGROPASSWORD=test

# Secret used to sign/verify JWTs (HS256). Must be >= 32 chars in production (openssl rand -base64 48).
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN_SECONDS=3600

# Requests per IP per 15 minutes across /auth/register + /auth/login
AUTH_RATE_LIMIT_MAX=20

# Number of proxies / load balancers in front of the app (0 = exposed directly)
TRUST_PROXY_HOPS=0
