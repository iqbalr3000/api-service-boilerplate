NODE_ENV=development
APP_ENV=local
SERVICE_NAME=api-service-boilerplate
PORT=3000

PGDATABASE=test
PGHOST=localhost
PGPORT=54321
PGUSER=test
PGPASSWORD=test

# Optional: enable read replica only if all four are set
# PGROHOST=localhost
# PGROPORT=54322
# PGROUSER=test
# PGROPASSWORD=test

AUTH_SERVICE_URL=http://localhost:3002
AUTH_VALIDATE_PATH=/api/v1/auth/verify-token
AUTH_VERIFY_PERMISSION_PATH=/api/v1/auth/verify-permission
AUTH_FALLBACK_TIMEOUT_MS=3000
AUTH_TOKEN_CACHE_TTL_SECONDS=120
